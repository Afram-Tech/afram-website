{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afram-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Incremental cache. Create with:
  //   yarn wrangler kv namespace create NEXT_INC_CACHE_KV
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "d401b3613d3a4ed4bb27f4eb95ddd736",
    },
  ],
  // Tag cache, so revalidateTag works. Create with:
  //   yarn wrangler d1 create afram-website-tag-cache
  // The `revalidations` table is created automatically on deploy.
  "d1_databases": [
    {
      // Must stay exactly NEXT_TAG_CACHE_D1 — OpenNext looks the binding up by name.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "afram-website-tag-cache",
      "database_id": "91ab0162-0f9e-4645-88c1-b36d69a4f9e8",
    },
  ],
  // Staging: the "afram-website-staging" Worker. Wrangler names an
  // environment's Worker "<name>-<env>", and Workers Builds accepts that as a
  // match — so one config serves both Workers. The staging Worker's deploy
  // command must pass the environment:
  //   npx opennextjs-cloudflare deploy --env staging
  // Bindings aren't inherited by environments, so they're repeated here.
  // These share production's cache stores; give staging its own KV namespace
  // and D1 database if its cache must never mix with production's.
  "env": {
    "staging": {
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "d401b3613d3a4ed4bb27f4eb95ddd736",
        },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "afram-website-tag-cache",
          "database_id": "91ab0162-0f9e-4645-88c1-b36d69a4f9e8",
        },
      ],
    },
  },
}
