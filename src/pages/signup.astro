---
import { buttonVariants } from "@/components/ui/button-variants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildSeo } from "@/lib/seo";

const seo = buildSeo({
  title: "Create Account",
  description:
    "Create an Afram account to browse verified properties, list a project, or deploy capital.",
  path: "/signup",
});
---

<BaseLayout seo={seo}>
  <section class="flex flex-1 items-center justify-center py-24">
    <div class="mx-auto max-w-md px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-ink-900 text-2xl font-bold tracking-[-0.02em]">Create your account</h1>
      <p class="text-ink-500 mt-3">
        Account creation is available on the Afram platform. Continue to sign up as a buyer, vendor,
        or financier.
      </p>
      <div class="mt-8">
        <a href="/" class={buttonVariants("primary")}>Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
