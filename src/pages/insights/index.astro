---
import { ARTICLES } from "@/features/landing/data/articles";
import ArticleCard from "@/features/landing/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildSeo } from "@/lib/seo";

const seo = buildSeo({
  title: "Insights — Guides & Market Data",
  description:
    "Guides, market data, and verification explainers from the Afram team, covering diaspora investing, title verification, and property financing in Ghana.",
  path: "/insights",
});
---

<BaseLayout seo={seo}>
  <section class="py-16">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-16">
      <h1
        class="text-ink-900 text-[clamp(2rem,4vw,2.75rem)] leading-[1.15] font-bold tracking-[-0.02em]"
      >
        Insights
      </h1>
      <p class="text-ink-500 mt-3 max-w-2xl text-[16px] leading-relaxed">
        Guides, market data, and verification explainers from the Afram team.
      </p>

      <div class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 sm:gap-y-10 lg:grid-cols-3 lg:gap-y-12">
        {ARTICLES.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
</BaseLayout>
