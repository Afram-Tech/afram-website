---
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildSeo } from "@/lib/seo";

const seo = buildSeo({
  title: "Privacy Policy",
  description: `How ${siteConfig.legalName} collects, uses, and protects your data.`,
  path: "/privacy-policy",
});
---

<BaseLayout seo={seo}>
  <section class="py-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-ink-900 text-[clamp(1.8rem,3vw,2.25rem)] font-bold tracking-[-0.02em]">
        Privacy Policy
      </h1>
      <p class="text-ink-500 mt-4">
        {siteConfig.legalName} (&quot;Afram&quot;, &quot;we&quot;, &quot;us&quot;) is committed to protecting
        your privacy. This page outlines how we collect, use, and safeguard information when you use our
        marketplace.
      </p>
      <p class="text-ink-400 mt-4 text-sm">
        This is placeholder content. Replace with your full privacy policy, terms of service, and
        cookie policy before launch.
      </p>
    </div>
  </section>
</BaseLayout>
