---
import { buttonVariants } from "@/components/ui/button-variants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildSeo } from "@/lib/seo";

const seo = buildSeo({
  title: "Log In",
  description: "Log in to your Afram account.",
  path: "/signin",
});
---

<BaseLayout seo={seo}>
  <section class="flex flex-1 items-center justify-center py-24">
    <div class="mx-auto max-w-md px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-ink-900 text-2xl font-bold tracking-[-0.02em]">Log in to Afram</h1>
      <p class="text-ink-500 mt-3">
        Don&apos;t have an account yet?
        <a href="/signup" class="text-brand-600 font-medium">Create one</a>.
      </p>
      <div class="mt-8">
        <a href="/" class={buttonVariants("primary")}>Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
