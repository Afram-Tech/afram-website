---
import { cn } from "@/lib/utils";

interface Props {
  id?: string;
  class?: string;
  container?: boolean;
}

const { id, class: className, container = true } = Astro.props;
---

<section id={id} class={cn("py-16 lg:py-24", className)}>
  {
    container ? (
      <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-16">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
