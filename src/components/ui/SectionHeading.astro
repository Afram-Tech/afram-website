---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { cn } from "@/lib/utils";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  eyebrowTone?: "brand" | "gold" | "sky" | "muted" | "light";
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  align = "left",
  tone = "dark",
  eyebrowTone = "brand",
  class: className,
} = Astro.props;
---

<div class={cn("max-w-2xl", align === "center" && "mx-auto text-center", className)}>
  {eyebrow ? <Eyebrow tone={eyebrowTone}>{eyebrow}</Eyebrow> : null}
  <h2
    class={cn(
      "mt-4 text-[clamp(1.6rem,2.4vw,2rem)] font-bold leading-[1.18] tracking-[-0.02em]",
      tone === "dark" ? "text-ink-900" : "text-white",
    )}
  >
    {title}
  </h2>
  {
    intro ? (
      <p
        class={cn(
          "mt-3.5 text-[16px] leading-relaxed",
          tone === "dark" ? "text-ink-500" : "text-white/75",
        )}
      >
        {intro}
      </p>
    ) : null
  }
</div>
