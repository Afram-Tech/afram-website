---
import { cn } from "@/lib/utils";

interface Props {
  src: string;
  alt?: string;
  class?: string;
  scrim?: number;
}

const { src, alt = "", class: className, scrim = 0 } = Astro.props;
---

<div class={cn("relative overflow-hidden bg-brand-700", className)}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover grayscale"
  />
  <div class="duotone-teal absolute inset-0" aria-hidden="true"></div>
  <div
    class="from-brand-900/35 to-brand-600/25 absolute inset-0 bg-gradient-to-br via-transparent"
    aria-hidden="true"
  >
  </div>
  {
    scrim > 0 ? (
      <div
        class="bg-brand-950 absolute inset-0"
        style={{ opacity: scrim / 100 }}
        aria-hidden="true"
      />
    ) : null
  }
  <slot />
</div>
