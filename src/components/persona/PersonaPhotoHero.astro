---
import PolygonWordmark from "@/components/PolygonWordmark.astro";

interface Props {
  image: string;
  imageAlt: string;
  headline: string[];
  subhead: string;
  ctaLabel: string;
  ctaHref: string;
}

const { image, imageAlt, headline, subhead, ctaLabel, ctaHref } = Astro.props;
---

<section class="bg-white px-6 pt-4 pb-6 sm:px-8 lg:px-16">
  <div
    class="relative mx-auto h-[520px] max-w-[1536px] overflow-hidden rounded-[2rem] sm:h-[580px] lg:h-[640px]"
  >
    <img src={image} alt={imageAlt} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

    <div
      class="relative z-10 flex h-full max-w-[640px] flex-col justify-center px-6 sm:px-10 lg:px-14"
    >
      <span
        class="inline-flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em] text-[#002d30]/70 uppercase"
      >
        Powered by
        <PolygonWordmark class="h-[12px] w-auto text-[#002D30]" />
      </span>

      <h1
        class="mt-6 text-[clamp(2.1rem,3.6vw,3.25rem)] leading-[1.05] tracking-[-0.03em] text-[#002d30]"
      >
        {
          headline.map((line, index) =>
            index === 0 ? (
              line
            ) : (
              <>
                <br />
                {line}
              </>
            ),
          )
        }
      </h1>

      <p class="mt-5 max-w-md text-[17px] leading-relaxed text-[#002D30]/75">{subhead}</p>

      <div class="mt-8">
        <a
          href={ctaHref}
          class="inline-flex h-12 items-center justify-center rounded-full bg-[#002d30] px-7 text-[15px] font-semibold text-white transition-all hover:bg-[#06474c] active:scale-[0.98]"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
