---
import { ExternalLink } from "lucide-react";
import { randomUUID } from "node:crypto";

import { siteConfig } from "@/config/site";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const dialogId = `verify-title-${randomUUID()}`;
---

<button type="button" data-verify-title-trigger={dialogId} class={cn("text-left", className)}>
  <slot>Verify a title</slot>
</button>
<dialog
  id={dialogId}
  class="border-ink-100 backdrop:bg-ink-950/50 m-auto max-w-sm overflow-hidden rounded-2xl border bg-white p-0 shadow-xl"
>
  <style>
    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(6px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    @keyframes lineDraw {
      from {
        stroke-dashoffset: 60;
        opacity: 0;
      }
      to {
        stroke-dashoffset: 0;
        opacity: 1;
      }
    }
    @keyframes arrowPop {
      0% {
        opacity: 0;
        transform: scale(0.5);
      }
      60% {
        opacity: 1;
        transform: scale(1.15);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes checkDraw {
      from {
        stroke-dashoffset: 24;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    .il-card-left {
      opacity: 0;
      animation: cardIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
      transform-origin: center;
    }
    .il-card-right {
      opacity: 0;
      animation: cardIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
      transform-origin: center;
    }
    .il-line {
      stroke-dasharray: 60;
      stroke-dashoffset: 60;
      opacity: 0;
      animation: lineDraw 0.5s ease-out 0.35s forwards;
    }
    .il-arrow {
      opacity: 0;
      animation: arrowPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) 0.75s forwards;
      transform-origin: 250px 95px;
    }
    .il-seal {
      opacity: 0;
      animation: cardIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
      transform-origin: 302px 85px;
    }
    .il-check {
      stroke-dasharray: 24;
      stroke-dashoffset: 24;
      animation: checkDraw 0.3s ease-out 0.85s forwards;
    }
    @media (prefers-reduced-motion: reduce) {
      .il-card-left,
      .il-card-right,
      .il-line,
      .il-arrow,
      .il-seal,
      .il-check {
        animation: none !important;
        opacity: 1 !important;
        stroke-dashoffset: 0 !important;
        transform: none !important;
      }
    }
  </style>

  <div class="bg-brand-50">
    <svg viewBox="0 0 400 180" class="h-40 w-full" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="60" cy="30" r="3" class="fill-brand-200"></circle>
      <circle cx="340" cy="140" r="4" class="fill-brand-200"></circle>
      <circle cx="200" cy="24" r="2.5" class="fill-brand-300"></circle>

      <path
        d="M150 95 C 190 95, 210 95, 250 95"
        class="il-line stroke-brand-300"
        stroke-width="2"
        stroke-linecap="round"></path>
      <path d="M244 88 L256 95 L244 102 Z" class="il-arrow fill-brand-500"></path>

      <g class="il-card-left">
        <rect
          x="46"
          y="55"
          width="104"
          height="80"
          rx="14"
          class="stroke-ink-200 fill-white"
          stroke-width="1.5"></rect>
        <circle cx="72" cy="80" r="8" class="fill-brand-100"></circle>
        <circle cx="72" cy="80" r="3" class="fill-brand-600"></circle>
        <rect x="88" y="76" width="42" height="7" rx="3.5" class="fill-ink-200"></rect>
        <rect x="62" y="102" width="76" height="6" rx="3" class="fill-ink-100"></rect>
        <rect x="62" y="114" width="54" height="6" rx="3" class="fill-ink-100"></rect>
      </g>

      <g class="il-card-right">
        <rect
          x="250"
          y="40"
          width="104"
          height="100"
          rx="14"
          class="stroke-ink-200 fill-white"
          stroke-width="1.5"></rect>
        <g class="il-seal">
          <path
            d="M302 58 L322 65 V84 C322 98 314 108 302 113 C290 108 282 98 282 84 V65 Z"
            class="fill-brand-50 stroke-brand-500"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <path
            d="M294 84 L300 90 L312 76"
            class="il-check stroke-brand-600"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </g>
        <rect x="270" y="122" width="64" height="6" rx="3" class="fill-ink-100"></rect>
      </g>
    </svg>
  </div>

  <div class="px-6 pt-5">
    <h2 class="text-ink-900 text-lg font-bold">You&apos;re leaving Afram</h2>
    <p class="text-ink-500 mt-1.5 text-sm">
      Title verification opens in a new tab at
      <span class="text-ink-700 font-medium">registry.afram.co</span>.
    </p>
  </div>

  <div class="flex justify-end gap-2 px-6 pt-5 pb-6">
    <button
      type="button"
      data-verify-title-cancel
      class="text-ink-700 hover:bg-ink-50 inline-flex h-11 items-center justify-center rounded-full px-5 text-[15px] font-semibold transition-colors"
    >
      Cancel
    </button>
    <a
      href={siteConfig.registryUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-verify-title-continue
      class="bg-brand-600 hover:bg-brand-700 inline-flex h-11 items-center justify-center gap-2 rounded-full px-5 text-[15px] font-semibold text-white transition-colors"
    >
      Continue
      <ExternalLink className="h-4 w-4" />
    </a>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-verify-title-trigger]").forEach((trigger) => {
    const dialogId = trigger.dataset.verifyTitleTrigger;
    const dialog = dialogId ? document.getElementById(dialogId) : null;
    if (!(dialog instanceof HTMLDialogElement)) return;

    trigger.addEventListener("click", () => dialog.showModal());
    dialog
      .querySelector("[data-verify-title-cancel]")
      ?.addEventListener("click", () => dialog.close());
    dialog
      .querySelector("[data-verify-title-continue]")
      ?.addEventListener("click", () => dialog.close());
  });
</script>
