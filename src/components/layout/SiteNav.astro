---
import { ChevronDown, Menu, X, ArrowRight } from "lucide-react";

import { buttonVariants } from "@/components/ui/button-variants";
import VerifyTitleDialog from "@/components/VerifyTitleDialog.astro";
import { NAV_GROUPS } from "@/config/navigation";

const navLinkClass =
  "rounded-lg px-3 py-2 text-[15px] font-medium text-ink-700 transition-colors hover:text-brand-600";
---

<header
  data-site-header
  class="sticky top-0 z-50 border-b border-transparent bg-white transition-all duration-200"
>
  <div
    class="mx-auto flex h-[72px] max-w-[1536px] items-center justify-between gap-4 px-6 sm:px-8 lg:px-16"
  >
    <a href="/" aria-label="Afram home" class="shrink-0">
      <img src="/afram-logo.svg" alt="Afram" class="h-10 w-auto" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        NAV_GROUPS.map((group) => (
          <div class="group relative" style={{ "--role": group.accentColor }}>
            <a
              href={group.href}
              class="text-ink-700 inline-flex items-center gap-1 rounded-lg px-3 py-2 text-[15px] font-medium transition-colors hover:[color:var(--role)]"
            >
              {group.label}
              <ChevronDown className="h-3.5 w-3.5 text-ink-300 transition-transform group-hover:rotate-180 group-hover:[color:var(--role)]" />
            </a>

            <div class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              <div class="border-ink-100 w-[360px] rounded-2xl border bg-white p-2 shadow-[0_16px_50px_-12px_rgba(0,86,94,0.18)]">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class="hover:bg-ink-50 flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors"
                  >
                    <span
                      class="mt-1.5 h-2 w-2 shrink-0 rounded-full"
                      style={{ backgroundColor: group.accentColor }}
                    />
                    <span>
                      <span class="text-ink-900 block text-sm font-semibold">{item.label}</span>
                      <span class="text-ink-500 block text-[13px]">{item.description}</span>
                    </span>
                  </a>
                ))}
                <a
                  href={group.href}
                  class="bg-ink-50 hover:bg-ink-100 mt-1 flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors"
                  style={{ color: group.accentColor }}
                >
                  Explore {group.exploreLabel}
                  <ArrowRight className="h-4 w-4" />
                </a>
              </div>
            </div>
          </div>
        ))
      }

      <a href="/insights" class={navLinkClass}>Insights</a>
      <VerifyTitleDialog class={navLinkClass}>Verify a title</VerifyTitleDialog>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href="/signup"
        class="text-ink-800 hover:text-brand-600 rounded-lg px-3.5 py-2 text-[15px] font-semibold transition-colors"
      >
        Create Account
      </a>
      <a href="/signin" class={buttonVariants("primary", "sm")}>Log In</a>
    </div>

    <button
      type="button"
      data-mobile-menu-trigger
      class="text-ink-900 hover:bg-brand-50 inline-flex h-10 w-10 items-center justify-center rounded-full lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Menu data-mobile-menu-icon-open className="h-5 w-5" />
      <X data-mobile-menu-icon-close className="hidden h-5 w-5" />
    </button>
  </div>
</header>

<div
  data-mobile-menu-panel
  class="fixed inset-x-0 top-[72px] bottom-0 z-40 hidden overflow-y-auto bg-white px-5 pt-3 pb-10 lg:hidden"
>
  <div class="divide-ink-100 divide-y">
    {
      NAV_GROUPS.map((group) => (
        <div class="py-3">
          <a
            href={group.href}
            class="flex items-center justify-between text-base font-semibold"
            style={{ color: group.accentColor }}
          >
            {group.label}
            <ArrowRight className="h-4 w-4 text-ink-300" />
          </a>
          <div class="mt-2 space-y-1 pl-1">
            {group.items.map((item) => (
              <a href={item.href} class="text-ink-500 block py-1.5 text-[15px]">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))
    }
    <a href="/insights" class="text-ink-900 block py-3 text-base font-semibold">Insights</a>
  </div>
  <div class="mt-6 flex flex-col gap-2.5">
    <a href="/signin" class={buttonVariants("primary", "lg", "w-full")}>Log In</a>
    <a
      href="/signup"
      class="bg-brand-50 text-brand-700 flex items-center justify-center rounded-xl px-4 py-3 text-base font-semibold"
    >
      Create Account
    </a>
    <VerifyTitleDialog
      class="bg-brand-50 text-brand-700 flex items-center justify-center rounded-xl px-4 py-3 text-base font-semibold"
    >
      Verify a title
    </VerifyTitleDialog>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const setScrolled = () => {
    const scrolled = window.scrollY > 8;
    header?.classList.toggle("border-ink-100", scrolled);
    header?.classList.toggle("bg-white/90", scrolled);
    header?.classList.toggle("backdrop-blur-md", scrolled);
    header?.classList.toggle("border-transparent", !scrolled);
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const trigger = document.querySelector<HTMLButtonElement>("[data-mobile-menu-trigger]");
  const panel = document.querySelector<HTMLElement>("[data-mobile-menu-panel]");
  const iconOpen = document.querySelector<HTMLElement>("[data-mobile-menu-icon-open]");
  const iconClose = document.querySelector<HTMLElement>("[data-mobile-menu-icon-close]");

  trigger?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("hidden") === false;
    trigger.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
    document.body.style.overflow = isOpen ? "hidden" : "";
  });
</script>
