---
import NewsletterForm from "@/components/layout/NewsletterForm";
import PolygonWordmark from "@/components/PolygonWordmark.astro";
import { FOOTER_COMPANY_LINKS, FOOTER_LEGAL_LINKS, FOOTER_SOCIAL_LINKS } from "@/config/navigation";
import { siteConfig } from "@/config/site";

const year = new Date().getFullYear();
---

<footer>
  <div class="border-ink-100 border-t bg-white">
    <div class="mx-auto max-w-[1536px] px-6 py-14 sm:px-8 lg:px-16 lg:py-16">
      <div
        class="border-ink-100 flex flex-col gap-5 border-b pb-10 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <img src="/afram-logo-dark.svg" alt="Afram" class="h-8 w-auto" />
          <p class="text-ink-400 mt-2 text-[13px]">{siteConfig.tagline}</p>
        </div>
        <span class="text-ink-400 inline-flex items-center gap-2 text-[13px] font-medium">
          POWERED BY
          <PolygonWordmark class="h-[13px] w-auto text-[#002D30]" />
        </span>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1fr_1.6fr]">
        <div>
          <h2 class="text-ink-900 text-[13px] font-bold tracking-[0.1em] uppercase">Company</h2>
          <ul class="mt-4 space-y-2.5">
            {
              FOOTER_COMPANY_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-ink-500 hover:text-brand-600 text-[15px] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-ink-900 text-[13px] font-bold tracking-[0.1em] uppercase">Follow us</h2>
          <ul class="mt-4 space-y-2.5">
            {
              FOOTER_SOCIAL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-ink-500 hover:text-brand-600 text-[15px] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-ink-900 text-[18px] font-bold tracking-[-0.01em]">
            Be the first to know.
          </h2>
          <p class="text-ink-500 mt-2 max-w-md text-[14px] leading-relaxed">
            Stay ahead in real estate. Get updates, expert tips, and insider insights delivered
            monthly.
          </p>
          <div class="mt-4 max-w-md">
            <NewsletterForm client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-brand-700 text-white/80">
    <div
      class="mx-auto flex max-w-[1536px] flex-col gap-3 px-6 py-5 text-[13px] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-16"
    >
      <p>© {year} {siteConfig.legalName}. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        {
          FOOTER_LEGAL_LINKS.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
